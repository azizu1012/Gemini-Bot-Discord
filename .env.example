# Copy this file to .env and fill in real values. Never commit .env.

# --- Discord ---
DISCORD_TOKEN=<discord-bot-token>
ADMIN_IDS=<discord-user-id>
# MODERATOR_IDS=<id1>,<id2>

# --- Database / Redis ---
# Docker Compose overrides these two URLs to point at the postgres/redis
# services (see docker-compose.yml). AZURIS_DB_PASSWORD is REQUIRED for
# Docker: use URL-safe characters [A-Za-z0-9_-] only.
AZURIS_DB_USER=azuris
AZURIS_DB_PASSWORD=<url-safe-password-for-docker-postgres>
AZURIS_DB_NAME=azuris
# Legacy local runtime only (ignored by Docker):
DATABASE_URL=postgresql://azuris@127.0.0.1:55432/azuris?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- Endpoint API key encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DONATE_ENCRYPTION_KEY=<fernet-key>
# Refuse to store plaintext endpoint keys when DONATE_ENCRYPTION_KEY is empty.
# Set true only for local testing if you accept the risk.
ALLOW_PLAINTEXT_ENDPOINT_KEYS=false

# --- Endpoint URL safety ---
# Loopback is always allowed for a local router_api.
# Set true only if the endpoint is on a trusted private LAN/ULA network.
ALLOW_PRIVATE_ENDPOINT_HOSTS=false

# --- Search APIs (optional, at least one recommended) ---
SERPAPI_API_KEY=<serpapi-key>
TAVILY_API_KEY=<tavily-key>
EXA_API_KEY=<exa-key>

# --- Weather (WeatherAPI.com) ---
WEATHER_API_KEY=<weatherapi-key>
CITY=Hanoi

# --- Runtime tuning ---
MAX_CONCURRENT_MESSAGES=3
LLM_TOTAL_TIMEOUT_SECONDS=120
GEMINI_TIMEOUT_MS=120000
REASONING_MAX_API_RETRIES=3
REASONING_MAX_LOOPS=3
FINAL_MAX_API_RETRIES=3
SEARCH_ENABLE_EXTRA_RETRIEVAL_PASS=false
SEARCH_ALLOW_PARTIAL_ANSWER=true
